<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AutoFix - Atelier</title>
  <style>
    :root {
      --fond: #f4f3ef; --carte: #ffffff; --texte: #1f2328; --doux: #626a73; --bord: #dedbd2;
      --encre: #22303c; --accent: #d9661f; --vert: #1f7a4d; --vert-fond: #e3f2ea;
      --rouge: #b42318; --rouge-fond: #fdecea;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--fond); color: var(--texte);
           font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
    header { background: var(--encre); color: #fff; }
    .barre { max-width: 1040px; margin: 0 auto; padding: 0 16px; display: flex; align-items: center;
             gap: 24px; flex-wrap: wrap; min-height: 60px; }
    .marque { font-weight: 700; font-size: 18px; letter-spacing: .5px; }
    .marque span { color: var(--accent); }
    nav { display: flex; gap: 4px; flex-wrap: wrap; }
    nav a { color: #c9d1d9; text-decoration: none; padding: 8px 12px; border-radius: 6px; }
    nav a:hover { background: rgba(255,255,255,.08); color: #fff; }
    nav a.actif { background: var(--accent); color: #fff; }
    main { max-width: 1040px; margin: 0 auto; padding: 28px 16px 48px; }
    h1 { font-size: 24px; margin: 0 0 4px; }
    .sous-titre { color: var(--doux); margin: 0 0 24px; }
    .carte { background: var(--carte); border: 1px solid var(--bord); border-radius: 10px; padding: 20px; margin-bottom: 20px; }
    .grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
    label { display: block; font-weight: 600; margin: 12px 0 4px; }
    input, select, textarea { width: 100%; padding: 9px 10px; border: 1px solid var(--bord); border-radius: 6px;
                              font: inherit; background: #fff; }
    textarea { min-height: 80px; }
    .ligne { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 12px; }
    @media (max-width: 640px) { .ligne { grid-template-columns: 1fr; } }
    button { margin-top: 16px; background: var(--accent); color: #fff; border: 0; border-radius: 6px;
             padding: 10px 18px; font: inherit; font-weight: 600; cursor: pointer; }
    button:hover { filter: brightness(.95); }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--bord); }
    th { font-size: 13px; text-transform: uppercase; letter-spacing: .4px; color: var(--doux); }
    td.nombre, th.nombre { text-align: right; font-variant-numeric: tabular-nums; }
    tfoot td { font-weight: 700; border-bottom: 0; }
    .alerte { padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid; }
    .alerte-erreur { background: var(--rouge-fond); color: var(--rouge); border-color: #f5c2bd; }
    .alerte-succes { background: var(--vert-fond); color: var(--vert); border-color: #b9dfc9; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
    .badge-libre { background: var(--vert-fond); color: var(--vert); }
    .badge-occupe { background: var(--rouge-fond); color: var(--rouge); }
    .compteur { font-size: 32px; font-weight: 700; line-height: 1.1; }
    .jauge { height: 8px; background: var(--vert-fond); border-radius: 4px; overflow: hidden; margin: 12px 0 8px; }
    .jauge div { height: 100%; background: var(--accent); }
    .doux { color: var(--doux); }
    .total { font-size: 22px; font-weight: 700; color: var(--encre); }
    .filtres a { margin-right: 8px; color: var(--encre); }
    .filtres a.actif { font-weight: 700; color: var(--accent); }
    dl.recap { display: grid; grid-template-columns: max-content 1fr; gap: 6px 20px; margin: 0; }
    dl.recap dt { color: var(--doux); }
    dl.recap dd { margin: 0; font-weight: 600; }
  </style>
</head>
<body>
  <header>
    <div class="barre">
      <div class="marque">Auto<span>Fix</span> · Atelier</div>
      <nav>
        <a href="/" class="{{#if (eq page 'accueil')}}actif{{/if}}">Tableau de bord</a>
        <a href="/reception" class="{{#if (eq page 'reception')}}actif{{/if}}">Réception</a>
        <a href="/pieces" class="{{#if (eq page 'pieces')}}actif{{/if}}">Pièces</a>
        <a href="/cloture" class="{{#if (eq page 'cloture')}}actif{{/if}}">Clôture</a>
        <a href="/postes" class="{{#if (eq page 'postes')}}actif{{/if}}">Postes</a>
      </nav>
    </div>
  </header>
  <main>
    {{{body}}}
  </main>
</body>
</html>
